{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": [
    "src/**/*.ts",
    "../../shared/src/watchlist/events/watched-show.event.ts",
    "../../shared/src/shows/models/show.model.ts",
    "../../shared/src/shows/services/shows.service.ts",
    "../../shared/src/shows/shows.module.ts"
, "../../shared/src/shows/services/shows-indexer.service.ts"  ],
  "exclude": [
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../shared/tsconfig.lib.json"
    }
  ]
}
